# ============================================================
# 이 파일을 복사해서 .env.prod 를 만들고 실제 값을 채워넣으세요
# GCE VM의 /opt/dreamtoon/.env.prod 에 위치시킵니다
# 절대 Git에 커밋하지 마세요!
# ============================================================

# Database (cloud-sql-proxy 컨테이너를 호스트로 사용)
DATABASE_URL=jdbc:postgresql://cloud-sql-proxy:5432/dreamtoon-postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Google OAuth2
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Kakao OAuth2
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# JWT
JWT_SECRET=YOUR_JWT_SECRET_MIN_256_BITS

# GCP
GCP_PROJECT_ID=dreamtoon-487717
GCS_BUCKET_NAME=dreamtoon-bucket

# Frontend URL (CORS)
FRONTEND_URL=https://your-frontend-domain.com
